@startuml 07_activity_escalation_2_reply
!include _style.iuml
skinparam defaultFontSize 13

|Секретарь|
start
:Открыть карточку обращения
в чате секретарей, выбрать
действие;
|Бот|
if (Пользователь в белом
списке секретарей?) then (нет)
  :Отказать в действии;
  stop
else (да)
endif
|Бот|
if (Действие) then (закрыть)
  :Отправить POST
  /tickets/{id}/close;
  |API|
  :Сохранить статус closed;
  |Бот|
  :Отметить карточку
  как закрытую;
  stop
else (ответить)
endif
|Бот|
if (Свой текст?) then (да)
  :Запросить текст ответа
  (состояние ожидания текста);
  |Секретарь|
  :Ввести текст ответа;
else (нет, черновик)
endif
|Бот|
:Отправить POST
/tickets/{id}/reply;
|API|
if (Обращение ещё open?) then (нет)
  :Вернуть 409;
  |Бот|
  :Сообщить, что обращение
  уже обработано;
  stop
else (да)
endif
|API|
:Сохранить ответ, секретаря,
время, статус answered; добавить
вопрос в список для пополнения
базы знаний;
|Бот|
:Отправить ответ студенту,
отметить карточку
как отвеченную;
|Студент|
:Получить ответ секретаря;
stop
@enduml
