# --- Bot ---
BOT_TOKEN=
LOG_LEVEL=INFO
# Comma-separated Telegram user IDs
SECRETARY_IDS=
# At most 1000: POST /ask rejects longer questions
MAX_QUESTION_LENGTH=1000
# Core API address for a local run. Empty: the bot answers from the stub.
# In Docker Compose it is overridden with http://api:8000.
API_URL=http://localhost:8000
# Per-operation HTTP timeout for admission, polling and acknowledgement
ANSWER_TIMEOUT=30
# Per HTTP request only. The bot polls queued work without a total queue deadline.

# --- API ---
# Shared service token of the bot, the API and n8n. Generate one, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# "stub" or the RAG engine factory "module:function", e.g. worker.rag:create_engine
RAG_ENGINE=worker.rag:create_engine
# Processing deadline after dequeue; queue wait is separate
RAG_TIMEOUT=130
# Processing only, starts when the worker claims the request (not on admission).
QUEUE_MAX_SIZE=20
QUEUE_POLL_INTERVAL=0.25
# Release a terminal job's delivery lock if the bot crashes before acknowledging it.
DELIVERY_TIMEOUT=120
CHAT_HISTORY_MESSAGES=5
CHAT_HISTORY_RETENTION_HOURS=48
CHAT_HISTORY_MAX_TOKENS=400
RAG_CONTEXT_MAX_TOKENS=1200
NUM_CTX=4096
NUM_PREDICT=256
QWEN_TOKENIZER=Qwen/Qwen3.5-9B
OLLAMA_TIMEOUT=120

# --- PostgreSQL ---
POSTGRES_USER=fpi
POSTGRES_PASSWORD=
POSTGRES_DB=fpi_rag
# URL-encode password characters; use postgres as host inside Docker Compose.
DATABASE_URL=postgresql+psycopg://fpi:CHANGE_ME@127.0.0.1:5432/fpi_rag
#LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=fpi_demo
# BGE-M3
EMBED_DEVICE=cpu

# Временный порог для прототипа
MIN_DENSE_SCORE=0.60
