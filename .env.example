# --- Bot ---
BOT_TOKEN=
LOG_LEVEL=INFO
# Comma-separated Telegram user IDs
SECRETARY_IDS=
# At most 1000: POST /ask rejects longer questions
MAX_QUESTION_LENGTH=1000
# Core API address for a local run. Empty: the bot answers from the stub.
# In Docker Compose it is overridden with http://api:8000.
API_URL=http://localhost:8000
# Seconds to wait for POST /ask
ANSWER_TIMEOUT=30

# --- API ---
# Shared service token of the bot, the API and n8n. Generate one, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# "stub" or the RAG engine factory "module:function", e.g. worker.rag:create_engine
RAG_ENGINE=stub
# Seconds the API waits for the RAG engine; keep below ANSWER_TIMEOUT
RAG_TIMEOUT=25

# --- PostgreSQL ---
POSTGRES_USER=fpi
POSTGRES_PASSWORD=
POSTGRES_DB=fpi_rag
